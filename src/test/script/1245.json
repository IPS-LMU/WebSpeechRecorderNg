                  {
                    "annotationTemplate": false,
                    "mimetype": "text/plain",
                    "text": "How did you get here today?"
                  }
                ]
              }
            ]
          },{
            "promptItems": [
              {
                "itemcode": "VL4",
                "mediaitems": [
                  {
                    "annotationTemplate": false,
                    "mimetype": "text/x-prompt",
                    "promptDoc": {
                      "body": {
                        "blocks": [
                          {
                            "type": "p",
                            "texts": [
                              {
                                "type": "text",
                                "text": "”Vind och sol slöt ett vad,"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "om vem som hade största kraften,"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "att en stackars vandrare"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "skulle berövas sina kläder."
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "Vinden började;"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "men hans stormande"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "gjorde honom intet; vandraren"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "drog sin mantel tätare omkring sig."
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "Vinden ger nu upp och vilar;"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "och en kär solens stråle"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "fyller med ljuv, mild glöd"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "vandrarens ben."
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "Sveper han sig nu djupare in?"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "Nej!"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "Av kastar han nu sitt plagg,"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "text",
                                "text": "och solen segrade."
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "font",
                                "style": "italic",
                                "text": {
                                  "type": "text",
                                  "text": "Våld och makt, förnuftets tvång"
                                }
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "font",
                                "style": "italic",
                                "text": {
                                  "type": "text",
                                  "text": "gör och lämnar oss kalla;"
                                }
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "font",
                                "style": "italic",
                                "text": {
                                  "type": "text",
                                  "text": "Varm Kristus-kärlek –"
                                }
                              },
                              {
                                "type": "linebreak"
                              },
                              {
                                "type": "font",
                                "style": "italic",
                                "text": {
                                  "type": "text",
                                  "text": "vem förblev henne kall?”"
                                }
                              },
                              {
                                "type": "linebreak"
                              },
                              {

                                "type": "text",
                                "text": "– Dikter, femte boken, Historia och fabel, 4:e fabeln."
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]

